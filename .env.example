# ---- App ------------------------------------------------------------------
NODE_ENV=development
# Deployment-wide IANA timezone used for transaction calendar dates.
TZ=UTC
# Leave empty for raw-IP / dynamic-host HTTP access. Set to your canonical
# HTTPS URL (no trailing slash) when running behind a TLS reverse proxy; its
# scheme controls whether authentication cookies use the Secure attribute.
APP_URL=
BETTER_AUTH_URL=
OIDC_REDIRECT_BASE=
# Direct HTTP needs false. Use auto (or true) with a public HTTPS origin.
AUTH_SECURE_COOKIES=false
# Reverse proxies whose X-Forwarded-For is believed for sign-in rate limits:
# comma-separated IPs/CIDRs. Empty trusts loopback and private networks; set
# `none` when Cura is reachable directly from untrusted private addresses.
TRUSTED_PROXIES=
PORT=3000
LOG_LEVEL=info

# Public showcase mode. WARNING: when true, Cura Money empties and refills
# every application table at startup and every 15 minutes. All users and
# sessions are deleted. Leave false for every normal installation.
DEMO_MODE=false

# ---- Database -------------------------------------------------------------
# SQLite file. Compose sets /data/cura.db on the cura_data volume; outside
# Docker the default is ./data/cura.db.
# DATABASE_PATH=./data/cura.db

# ---- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32  (must be >= 32 chars)
BETTER_AUTH_SECRET=replace-with-32-bytes-of-random-base64
# Optional stable key for encrypted OIDC and SimpleFIN credentials. Set this
# before rotating BETTER_AUTH_SECRET. During key rotation, keep old data keys
# as a comma-separated list until all stored credentials have been resealed.
# DATA_ENCRYPTION_KEY=replace-with-a-different-32-byte-random-base64-key
# DATA_ENCRYPTION_KEY_PREVIOUS=old-32-byte-random-base64-key

# ---- Cron -----------------------------------------------------------------
# RUN_CRON=true enables the in-process SimpleFIN poll, budget roll-forward,
# and retention jobs. Set it false to disable scheduled jobs entirely.
# Schedules are hardcoded in src/jobs/cron.ts and always use UTC.
RUN_CRON=true

# Destructive financial-data retention is disabled by default. Set a positive
# number of days to opt in; transactions and older budget overrides are then
# removed on startup and by the daily retention job.
RETENTION_DAYS=0

# ---- MCP server -------------------------------------------------------------
# Remote MCP server at /mcp, so self-hosted agents can read balances,
# transactions, budgets, and reports, and (with a read-and-write token) do
# what the web app does with money: edit, split, and delete transactions,
# work through reviews, and manage accounts, categories, rules, budgets,
# paydown, goals, and recurring charges.
# Clients authenticate with a personal access token created in Settings
# (Authorization: Bearer <token>). Serve it over
# HTTPS (via your reverse proxy); plain HTTP is only accepted on loopback and
# private LAN addresses. Always disabled in DEMO_MODE.
MCP_ENABLED=true
